DATABASE_URL=sqlite:///./insightflow.db
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
# responses | chat | json (compatible endpoints without structured outputs)
LLM_PROTOCOL=responses
ENABLE_TRACING=false
GITHUB_TOKEN=

# DeepSeek Flash (use these instead of the OpenAI settings above):
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
# LLM_PROTOCOL=json

# Optional compliant third-party public WeChat search API.
# Contract: GET ?q=... -> {"results":[{"title":"...","url":"https://mp.weixin.qq.com/s/..."}]}
WECHAT_SEARCH_API_URL=
WECHAT_SEARCH_API_KEY=

# General public search (official Tavily API)
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily
